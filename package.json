{
  "name": "proofkit-ai",
  "version": "0.1.0",
  "description": "Evidence-driven AI system testing for Web, Electron and mobile applications.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shutu-hub/proofkit-ai.git" },
  "bin": { "proofkit": "bundle/main.js", "proofkit-mcp": "bundle/server.js" },
  "files": ["bundle", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build && node scripts/build-distribution.mjs",
    "prepare": "node scripts/prepare-git-install.mjs",
    "prepack": "pnpm build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency 2 test",
    "test:smoke:web": "pnpm build && node tests/web-smoke.mjs",
    "test:smoke:inspect": "pnpm build && node tests/inspection-smoke.mjs",
    "test:smoke:electron": "pnpm build && node tests/electron-smoke.mjs",
    "test:smoke:target-continuity": "pnpm build && node tests/target-continuity-smoke.mjs",
    "test:smoke:target-linux": "pnpm build && node tests/linux-target-binding-smoke.mjs",
    "test:smoke:electron:file": "pnpm build && node tests/electron-file-route-smoke.mjs",
    "test:smoke:mobile": "pnpm build && node tests/mobile-smoke.mjs",
    "test:smoke:local:web": "pnpm build && node tests/local-runner-aihr-smoke.mjs web",
    "test:smoke:local:electron": "pnpm build && node tests/local-runner-aihr-smoke.mjs electron",
    "test:smoke:suite": "pnpm build && node tests/release-suite-smoke.mjs",
    "test:smoke:upload": "pnpm build && node tests/upload-smoke.mjs",
    "test:smoke:response": "pnpm build && node tests/response-capture-smoke.mjs",
    "test:smoke:electron-ipc": "pnpm build && node tests/electron-ipc-response-smoke.mjs",
    "test:smoke:ci-gate": "pnpm build && node tests/mission-ci-gate-smoke.mjs",
    "test:smoke:repair": "pnpm build && node tests/repair-hypothesis-smoke.mjs",
    "test:smoke:reviewed-workflow": "pnpm build && node tests/reviewed-workflow-smoke.mjs",
    "test:smoke:reviewed-release": "pnpm build && node tests/reviewed-release-smoke.mjs",
    "test:smoke:manual-intake": "pnpm build && node tests/aihr-manual-intake-smoke.mjs",
    "test:smoke:lifecycle": "pnpm build && node tests/integration-lifecycle-smoke.mjs",
    "test:smoke:recovery": "pnpm build && node tests/resource-recovery-smoke.mjs",
    "test:distribution": "node tests/distribution-smoke.mjs",
    "test:git-install": "node tests/git-install-smoke.mjs",
    "test:git-install:remote": "node tests/git-install-smoke.mjs --remote",
    "benchmark:planner": "pnpm build && node tests/planner-benchmark.mjs",
    "benchmark:webarena": "node scripts/webarena-benchmark.mjs",
    "benchmark:webarena:host-audit": "node scripts/webarena-host-audit.mjs",
    "benchmark:webarena:run-host": "node scripts/webarena-run-host.mjs",
    "benchmark:webarena:diagnose": "node scripts/webarena-diagnose.mjs",
    "test:webarena": "node --test tests/webarena-benchmark.test.mjs tests/webarena-environment.test.mjs tests/webarena-official.test.mjs tests/webarena-run-host.test.mjs tests/webarena-diagnose.test.mjs",
    "test:smoke:benchmark-har": "pnpm build && node tests/benchmark-har-smoke.mjs",
    "test:smoke:benchmark-mission": "pnpm build && node tests/benchmark-mission-smoke.mjs",
    "test:smoke:benchmark-task": "pnpm build && node tests/benchmark-task-session-smoke.mjs",
    "benchmark:host": "pnpm build && node tests/host-evaluation.mjs",
    "benchmark:host:claude": "pnpm build && node tests/host-evaluation.mjs --host claude-code --implicit-skill",
    "benchmark:host:baseline": "pnpm build && node tests/host-evaluation-baseline.mjs",
    "benchmark:host:claude:protocol": "pnpm build && node tests/host-evaluation-baseline.mjs --protocol claude-code",
    "benchmark:host:electron": "pnpm build && node tests/host-evaluation-baseline.mjs --cases electron-core-pass,electron-core-defect",
    "test:host-verifier": "node --test tests/host-evaluation-verifier.test.mjs tests/host-evaluation-runtime.test.mjs tests/host-evaluation-cli.test.mjs tests/claude-host-events.test.mjs",
    "test:host-evaluator": "pnpm build && node --test tests/host-evaluation-cli.test.mjs",
    "dev": "pnpm --filter @proofkit/cli dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "14.0.3",
    "playwright-core": "1.62.1",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "pnpm": "10.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
