{
  "name": "proofkit-ai",
  "version": "0.1.0",
  "description": "Evidence-driven AI system testing for Web, Electron and mobile applications.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shutu-hub/proofkit-ai.git" },
  "bin": { "proofkit": "bundle/main.js", "proofkit-mcp": "bundle/server.js" },
  "files": ["bundle", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build && node scripts/build-distribution.mjs",
    "prepack": "pnpm build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:smoke:web": "pnpm build && node tests/web-smoke.mjs",
    "test:smoke:inspect": "pnpm build && node tests/inspection-smoke.mjs",
    "test:smoke:electron": "pnpm build && node tests/electron-smoke.mjs",
    "test:smoke:local:web": "pnpm build && node tests/local-runner-aihr-smoke.mjs web",
    "test:smoke:local:electron": "pnpm build && node tests/local-runner-aihr-smoke.mjs electron",
    "test:smoke:suite": "pnpm build && node tests/release-suite-smoke.mjs",
    "test:smoke:upload": "pnpm build && node tests/upload-smoke.mjs",
    "test:smoke:response": "pnpm build && node tests/response-capture-smoke.mjs",
    "test:smoke:manual-intake": "pnpm build && node tests/aihr-manual-intake-smoke.mjs",
    "test:smoke:lifecycle": "pnpm build && node tests/integration-lifecycle-smoke.mjs",
    "test:smoke:recovery": "pnpm build && node tests/resource-recovery-smoke.mjs",
    "test:distribution": "node tests/distribution-smoke.mjs",
    "benchmark:planner": "pnpm build && node tests/planner-benchmark.mjs",
    "benchmark:host": "pnpm build && node tests/host-evaluation.mjs",
    "benchmark:host:baseline": "pnpm build && node tests/host-evaluation-baseline.mjs",
    "test:host-verifier": "node --test tests/host-evaluation-verifier.test.mjs tests/host-evaluation-runtime.test.mjs",
    "test:host-evaluator": "pnpm build && node --test tests/host-evaluation-cli.test.mjs",
    "dev": "pnpm --filter @proofkit/cli dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "14.0.3",
    "playwright-core": "1.62.1",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
